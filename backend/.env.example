# Copy this file to .env and fill in real values. Never commit .env.

# Neon Postgres connection string
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# JWT signing secret - use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=changeme
JWT_ALGORITHM=HS256

# Token lifetimes, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
FIRST_LOGIN_TOKEN_EXPIRE_MINUTES=15

# Optional: seeds one admin user on startup if no admin exists yet.
# Leave unset after the first real admin is created.
ADMIN_BOOTSTRAP_LOGIN_ID=DF-ADAD-2026-0000
ADMIN_BOOTSTRAP_EMAIL=admin@dayflow.example
ADMIN_BOOTSTRAP_PASSWORD=changeme-strong-temp-password
